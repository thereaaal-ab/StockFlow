# Supabase Project URL
SUPABASE_URL=https://trihldwbuukpqesttwnk.supabase.co

# Frontend Supabase Configuration (safe to expose)
VITE_SUPABASE_URL=https://trihldwbuukpqesttwnk.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend Supabase Configuration (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Connection String (Postgres URI)
# Get this from: Supabase Dashboard > Settings > Database > Connection string
# Select "URI" mode and copy the connection string
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.trihldwbuukpqesttwnk:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication Configuration
# Set to "true" to skip authentication (useful for local dev without Google OAuth)
# Set to "false" to require authentication (production default)
VITE_SKIP_AUTH=true
