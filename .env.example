# Supabase Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Frontend Supabase Configuration (safe to expose)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Production app URL used for OAuth redirect (set in Vercel env vars)
VITE_APP_URL=https://your-app.vercel.app

# Backend Supabase Configuration (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database Connection String (Postgres URI)
SUPABASE_DB_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# Server Configuration
PORT=5000
NODE_ENV=development

# Admin emails for recurring costs: server (Express) and browser (must match for UI buttons)
ADMIN_EMAILS=admin@example.com
VITE_ADMIN_EMAILS=admin@example.com
